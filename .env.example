# ----------------------------------------------------------------------
# TEMPLATE FILE - safe to share / commit to git. Contains NO real secrets.
# Copy this file to ".env.local" (Next.js loads it automatically) and paste
# your real values there. NEVER commit .env.local.
# ----------------------------------------------------------------------

# MongoDB Atlas connection string.
# Atlas dashboard > Connect > Drivers > copy the "mongodb+srv://..." URI and
# replace <db_password> with your database user's password.
MONGODB_URI=mongodb+srv://USER:PASSWORD@YOUR-CLUSTER.mongodb.net/?retryWrites=true&w=majority

# Database name to use inside the cluster (defaults to property_platform).
MONGODB_DB=property_platform

# Secret used to sign session cookies (JWTs). Generate your own with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=generate-a-random-32-byte-base64url-string

# Cloudinary — image & video uploads (console > Dashboard / Settings > API Keys).
CLOUDINARY_CLOUD_NAME=egluafvj
CLOUDINARY_API_KEY=553715215351478
CLOUDINARY_API_SECRET=poiQTZexfIoqLgi172A-9TxIiw4
