# ----------------------------------------------------------------------
# TEMPLATE FILE - safe to share / commit to git. Contains NO real secrets.
# Copy this file to ".env.local" (Next.js loads it automatically) and paste
# your real values there. NEVER commit .env.local.
# ----------------------------------------------------------------------

# MongoDB Atlas connection string.
# Atlas dashboard > Connect > Drivers > copy the "mongodb+srv://..." URI and
# replace <db_password> with your database user's password.
MONGODB_URI=mongodb+srv://USER:PASSWORD@YOUR-CLUSTER.mongodb.net/?retryWrites=true&w=majority

# Database name to use inside the cluster (defaults to property_platform).
MONGODB_DB=property_platform

# Secret used to sign session cookies (JWTs). Generate your own with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=generate-a-random-32-byte-base64url-string

# Cloudinary — image & video uploads (console > Dashboard / Settings > API Keys).
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret                                                                                                                                            

# Google OAuth — console.cloud.google.com > APIs & Services > Credentials >
# OAuth 2.0 Client ID (Web application). Authorized redirect URI must be
#   <your-origin>/api/v1/auth/google/callback  (e.g. http://localhost:3000/... and the Vercel URL)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# SmsLocal (India SMS gateway, no DLT needed) — the preferred OTP provider when
# SMSLOCAL_API_KEY is set. Get the key at app.smslocal.in > Developer > Http Api.
# ROUTE 2 = OTP. SENDER + TEMPLATE_ID are only needed for the DLT route.
SMSLOCAL_API_KEY=your-smslocal-api-key
SMSLOCAL_ROUTE=2

# Firebase Phone Auth (OTP via Firebase — free tier, no DLT). Client config is
# public (NEXT_PUBLIC_*). For the server, set EITHER the inline service-account
# JSON (minified, one line — use this on Vercel) OR a path to the JSON file (dev).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# FIREBASE_SERVICE_ACCOUNT='{"type":"service_account",...}'
FIREBASE_SERVICE_ACCOUNT_PATH=firebase-service-account.json

# Layer A — app-level OTP send cap. Hard-stops sends once reached (falls back to
# "use email"). Set BELOW your provider's free quota so you can never be charged.
# 0 / unset = no cap. Counts real-provider sends only (dev fallback is free).
OTP_DAILY_CAP=0
OTP_MONTHLY_CAP=0
# SMSLOCAL_SENDER=ALERTS
# SMSLOCAL_TEMPLATE_ID=123xxxxxxxxxxxxxxx

# Twilio — mobile OTP via WhatsApp (Programmable Messaging; works on a trial via
# the WhatsApp Sandbox — no Verify service/upgrade needed). Leave blank to use the
# free DEV fallback (code printed to the server console). The sandbox number +
# join word are shown in your console (Messaging > Try it out > WhatsApp) and
# VARY per account — use the exact number you see there (e.g. whatsapp:+1XXXXXXXXXX).
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
# Set ONE of these. SMS (no template needed) is preferred when set; otherwise
# WhatsApp is used. SMS to India from a US trial number may be carrier-filtered.
# TWILIO_SMS_FROM=+1XXXXXXXXXX
TWILIO_WHATSAPP_FROM=whatsapp:+1XXXXXXXXXX
# Optional: set this only if Twilio rejects freeform with "21654 ContentSid
# Required". Create a template in Messaging > Content Template Builder with body
# "Your OROVA verification code is {{1}}..." and paste its HX... SID here.
# TWILIO_CONTENT_SID=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
