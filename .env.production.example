# ======================================================================
# property-platform — PRODUCTION environment template
# Deploy target (your enrollnexus pattern): /srv/<app>/app/.env.production
#
#   cp .env.production.example .env.production   # then fill real values
#   chown <app>:<app> .env.production && chmod 600 .env.production
#
# IMPORTANT — this app differs from your GME / CRM apps:
#   * Custom JWT auth  -> uses AUTH_SECRET  (NOT NEXTAUTH_SECRET / NEXTAUTH_URL)
#   * No email yet     -> no RESEND_* keys needed
#   * Needs Cloudinary -> three CLOUDINARY_* keys
# ======================================================================

# --- Database -----------------------------------------------------------
# Reuse the shared Atlas cluster; give THIS app its own database name.
# NOTE: our code reads MONGODB_DB — the db name in the URI path is IGNORED,
# so you do NOT need the sed '/olncrm?/...' swap you use for the CRM apps.
MONGODB_URI=mongodb+srv://USER:PASSWORD@YOUR-CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=property_platform

# --- Auth (custom JWT sessions — NOT NextAuth) --------------------------
# Generate on the server:   openssl rand -base64 32
AUTH_SECRET=

# --- Runtime ------------------------------------------------------------
# Enables secure (HTTPS-only) session cookies. `next start` sets this to
# production anyway, but keep it explicit to match your other apps.
NODE_ENV=production

# --- Media uploads (Cloudinary) ----------------------------------------
CLOUDINARY_CLOUD_NAME=egluafvj
CLOUDINARY_API_KEY=553715215351478
CLOUDINARY_API_SECRET=poiQTZexfIoqLgi172A-9TxIiw4

# --- Public URL (optional) ---------------------------------------------
NEXT_PUBLIC_APP_URL=https://CHANGE-ME.enrollnexus.com
