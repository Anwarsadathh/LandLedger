# ======================================================================
# property-platform — PRODUCTION environment TEMPLATE (safe to commit).
# PLACEHOLDERS ONLY — never put real secrets in this file.
#
# Real production values go in your host's env settings:
#   * Vercel:  Project > Settings > Environment Variables
#   * Droplet: /srv/<app>/app/.env.production  (git-ignored, chmod 600)
#
# This app differs from the GME / CRM apps:
#   * Custom JWT auth  -> uses AUTH_SECRET  (NOT NEXTAUTH_SECRET / NEXTAUTH_URL)
#   * No email yet     -> no RESEND_* keys needed
#   * Needs Cloudinary -> three CLOUDINARY_* keys
# ======================================================================

# --- Database -----------------------------------------------------------
# Our code reads MONGODB_DB, so the db name in the URI path is ignored.
MONGODB_URI=mongodb+srv://USER:PASSWORD@YOUR-CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=property_platform

# --- Auth (custom JWT sessions — NOT NextAuth) --------------------------
# Generate:  openssl rand -base64 32   (or node crypto randomBytes)
AUTH_SECRET=generate-a-random-32-byte-base64-string

# --- Runtime ------------------------------------------------------------
NODE_ENV=production

# --- Media uploads (Cloudinary) ----------------------------------------
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# --- Public URL (optional) ---------------------------------------------
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app
